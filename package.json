{
  "name": "looplocal",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=26 <27" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "tsx scripts/production-guard.ts && next start",
    "lint": "eslint",
    "test": "sh scripts/test-local.sh",
    "test:e2e": "node scripts/test-e2e-local.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "production:migrate": "tsx scripts/production-migrate.ts",
    "production:release-preflight": "tsx scripts/production-migrate.ts --release-preflight",
    "production:ops-check": "tsx scripts/production-ops-check.ts",
    "operator:provision-identity": "tsx scripts/operator-provision-identity.ts",
    "operator:reset-credential": "tsx scripts/operator-reset-credential.ts",
    "operator:register-tag": "tsx scripts/operator-register-tag.ts",
    "production:backup": "bash scripts/production-backup.sh",
    "production:restore-check": "bash scripts/production-restore-check.sh",
    "production:local-dry-run": "bash scripts/production-local-dry-run.sh",
    "db:seed": "tsx scripts/seed.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "worker": "tsx scripts/worker.ts",
    "retention:prune": "tsx scripts/retention-prune.ts",
    "rate-limits:prune": "tsx scripts/prune-rate-limits.ts",
    "local": "sh scripts/local-start.sh",
    "preview": "sh scripts/preview-start.sh",
    "preview:browser-check": "node scripts/preview-browser-check.mjs",
    "preview:backup": "sh scripts/preview-backup.sh",
    "preview:restore-check": "sh scripts/preview-restore-check.sh",
    "preview:worker": "sh scripts/preview-worker.sh",
    "device-test:prepare": "sh scripts/device-test-prepare.sh",
    "device-test:start": "sh scripts/device-test-start.sh",
    "device-test:stop": "sh scripts/device-test-db-stop.sh",
    "device-test:worker": "sh scripts/device-test-worker.sh",
    "backup": "sh scripts/backup.sh",
    "restore-check": "sh scripts/restore-check.sh",
    "marketing:build": "tsx marketing-site/build.mts",
    "marketing:test": "tsx --test marketing-site/tests/*.test.ts",
    "marketing:verify": "node marketing-site/verify.mjs",
    "marketing:preview": "node marketing-site/preview.mjs",
    "nfc:reader-check": "tsx scripts/nfc-operator.ts reader-check",
    "nfc:provision": "tsx scripts/nfc-operator.ts provision",
    "nfc:tag-status": "tsx scripts/nfc-operator.ts tag-status",
    "nfc:tag-revoke": "tsx scripts/nfc-operator.ts tag-revoke",
    "nfc:tag-prepare": "tsx scripts/nfc-tag-prepare.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.2.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "motion": "^14.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
