# Local only. Generate a fresh BETTER_AUTH_SECRET for each environment.
DATABASE_URL=postgresql://looplocal:looplocal_local_only@localhost:54329/looplocal
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_REGISTRATION_ENABLED=false
# Invite-gated staff sign-up (only the invited address, only with the invitation token; owner-approved for the pilot, default off).
# It requires PUBLIC_REGISTRATION_ENABLED=false; the production guard refuses any other combination and any value other than true/false.
STAFF_INVITE_SIGNUP_ENABLED=false
# Local only; production requires cloudflare_tunnel and verified private ingress.
TRUSTED_INGRESS=local
# Legacy switch must remain false or absent; true is no longer supported.
TRUST_PROXY_CLIENT_IP=false
EXTERNAL_EMAIL_ENABLED=false
TRANSACTIONAL_EXTERNAL_EMAIL_ENABLED=false
PROMOTIONAL_EXTERNAL_EMAIL_ENABLED=false
MAILGUN_PROMOTIONAL_SEND_APPROVED=false
PROMOTIONAL_MONTHLY_LOCATION_LIMIT=
PROMOTIONAL_CUSTOMER_COOLDOWN_HOURS=
PROMOTIONAL_UNSUBSCRIBE_ORIGIN=
PROMOTIONAL_UNSUBSCRIBE_SECRET=
MAILGUN_SEND_APPROVED=false
MAILGUN_EU_DOMAIN=
MAILGUN_FROM_EMAIL=
MAILGUN_EU_API_KEY=
MAILGUN_EU_WEBHOOK_SIGNING_KEY=
LIVE_BILLING_ENABLED=false
BILLING_FIXTURE_MODE=false
BILLING_FIXTURE_SECRET=
APPLE_WALLET_ENABLED=false
GOOGLE_WALLET_ENABLED=false
# Separate scoped Google provider; selecting it does not enable issuance.
GOOGLE_WALLET_PROVIDER=GOOGLE_DIRECT
GOOGLE_WALLET_LOCATION_CLASSES=[]
# Production only: separate operator approval required before either Wallet provider may be enabled.
WALLET_PRODUCTION_APPROVED=false
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_SIGNING_CERT_PATH=
APPLE_SIGNING_KEY_PATH=
APPLE_WWDR_CERT_PATH=
APPLE_WALLET_AUTH_SECRET=
APPLE_WALLET_WEB_SERVICE_URL=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_FILE=
GOOGLE_WALLET_PUBLISHING_STATUS=demo
GOOGLE_WALLET_PROGRAM_LOGO_URL=
GOOGLE_WALLET_ASSET_ENABLED=false
GOOGLE_WALLET_ASSET_ORIGIN=
SMTP_HOST=localhost
SMTP_PORT=1026
DEFAULT_CURRENCY=EUR
DEFAULT_LOCALE=de
NEXT_PUBLIC_DRAFT_EUR_PRICE_MINOR=4900
DRAFT_MAD_PRICE_MINOR=39700
DEMO_REQUEST_RECIPIENT=local@mailpit.test

# Apple Wallet provider: PassFast managed signing. Off until separately approved.
PASSFAST_ENABLED=false
PASSFAST_API_KEY=
PASSFAST_APP_ID=
# Exact approved tenant/location/template triples; no default/global fallback in any environment.
# UUIDs and merchant branding/language need operator approval. Empty is safe while OFF.
# Example: [{"tenantId":"<tenant UUID>","locationId":"<location UUID>","templateId":"<published merchant template UUID>"}]
# PASSFAST_TENANT_TEMPLATES=
PASSFAST_WALLET_TYPES=apple

# Founder console: separate HTTPS origin and host-only sign-in cookie.
ADMIN_ORIGIN=
# Production: cloudflare. Local disposable testing only: local_test.
ADMIN_ACCESS_MODE=
# Team hostname, without scheme or path (example: your-team.cloudflareaccess.com).
ADMIN_ACCESS_TEAM_DOMAIN=
ADMIN_ACCESS_AUD=
# Comma-separated founder, partner and offline backup email addresses.
ADMIN_ALLOWED_EMAILS=
# Local mode only: public JWKS JSON from admin:local-access. Never use in production.
ADMIN_ACCESS_TEST_JWKS=
